.db/

# ==============================================================================
# Editor & Operating System Junk
# ==============================================================================
# OS Files
.DS_Store
Thumbs.db

# VS Code (Keeps teamwork settings, ignores local states)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/

# ==============================================================================
# Package Manager Lockfiles Note
# ==============================================================================
# DO NOT ignore package-lock.json, yarn.lock, or pnpm-lock.yaml. 
# Committing lockfiles is standard production practice to ensure consistent builds across teams and CI/CD pipelines.
